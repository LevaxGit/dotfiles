/* ══════════════════════════════════════════
   Rofi Theme — Matugen Dynamic Colors
   ══════════════════════════════════════════ */

* {
    bg0:     #141318;
    bg1:     #201f25;
    bg2:     #2b292f;
    accent:  #c8bfff;
    urgent:  #ffb4ab;
    fg0:     #e5e1e9;
    fg1:     #c9c5d0;
    fg2:     #928f99;

    font:                "JetBrainsMono NFP 14";
    background-color:    transparent;
    text-color:          @fg0;
    border-color:        @accent;
}

window {
    background-color:    @bg0;
    border:              1px;
    border-color:        @accent;
    border-radius:       14px;
    width:               560px;
    padding:             12px;
    location:            center;
}

mainbox {
    background-color:    transparent;
    children:            [ inputbar, listview ];
    spacing:             10px;
}

inputbar {
    background-color:    @bg1;
    border-radius:       10px;
    padding:             10px 14px;
    spacing:             10px;
    children:            [ prompt, entry ];
}

prompt {
    background-color:    transparent;
    text-color:          @accent;
    font:                "JetBrainsMono NFP Bold 14";
}

entry {
    background-color:    transparent;
    text-color:          @fg0;
    placeholder:         "Search...";
    placeholder-color:   @fg2;
    cursor:              text;
}

listview {
    background-color:    transparent;
    columns:             1;
    lines:               8;
    scrollbar:           false;
    spacing:             4px;
    fixed-height:        true;
}

element {
    background-color:    transparent;
    border-radius:       8px;
    padding:             10px 12px;
    spacing:             12px;
    children:            [ element-icon, element-text ];
    orientation:         horizontal;
    cursor:              pointer;
}

element normal.normal {
    text-color:          @fg0;
}

element alternate.normal {
    text-color:          @fg1;
}

element selected.normal {
    background-color:    @bg2;
    border:              1px;
    border-color:        @accent;
    text-color:          @accent;
}

element normal.urgent,
element selected.urgent {
    background-color:    @urgent;
}

element-icon {
    background-color:    transparent;
    size:                32px;
    cursor:              inherit;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    highlight:           bold #c8bfff;
    cursor:              inherit;
    vertical-align:      0.5;
}
