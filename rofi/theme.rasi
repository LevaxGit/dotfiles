/* ══════════════════════════════════════════
   Rofi Theme — Catppuccin Mocha · With Icons
   ══════════════════════════════════════════ */

* {
    bg0:     rgba(17, 17, 27, 0.86);
    bg1:     rgba(49, 50, 68, 0.71);
    bg2:     rgba(88, 91, 112, 0.39);
    accent:  rgba(137, 180, 250, 1.0);
    urgent:  rgba(243, 139, 168, 1.0);
    fg0:     rgba(205, 214, 244, 1.0);
    fg1:     rgba(166, 173, 200, 1.0);
    fg2:     rgba(108, 112, 134, 1.0);

    font:                "JetBrainsMono NFP 14";
    background-color:    transparent;
    text-color:          @fg0;
    border-color:        @accent;
}

window {
    background-color:    @bg0;
    border:              1px;
    border-color:        rgba(137, 180, 250, 0.31);
    border-radius:       14px;
    width:               560px;
    padding:             12px;
    location:            center;
}

mainbox {
    background-color:    transparent;
    children:            [ inputbar, listview ];
    spacing:             10px;
}

inputbar {
    background-color:    @bg1;
    border-radius:       10px;
    padding:             10px 14px;
    spacing:             10px;
    children:            [ prompt, entry ];
}

prompt {
    background-color:    transparent;
    text-color:          @accent;
    font:                "JetBrainsMono NFP Bold 14";
}

entry {
    background-color:    transparent;
    text-color:          @fg0;
    placeholder:         "Search...";
    placeholder-color:   @fg2;
    cursor:              text;
}

listview {
    background-color:    transparent;
    columns:             1;
    lines:               8;
    scrollbar:           false;
    spacing:             4px;
    fixed-height:        true;
}

element {
    background-color:    transparent;
    border-radius:       8px;
    padding:             10px 12px;
    spacing:             12px;
    children:            [ element-icon, element-text ];
    orientation:         horizontal;
    cursor:              pointer;
}

element normal.normal {
    text-color:          @fg0;
}

element alternate.normal {
    text-color:          @fg1;
}

element selected.normal {
    background-color:    rgba(137, 180, 250, 0.18);
    border:              1px;
    border-color:        rgba(137, 180, 250, 0.39);
    text-color:          @accent;
}

element normal.urgent,
element selected.urgent {
    background-color:    rgba(243, 139, 168, 0.18);
}

element-icon {
    background-color:    transparent;
    size:                32px;
    cursor:              inherit;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    highlight:           bold #89b4fa;
    cursor:              inherit;
    vertical-align:      0.5;
}
